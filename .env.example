# .env.local にコピーして値を入れる。どちらか一方があれば動く。
# 両方ある場合は TypeSafe 直結が既定。--provider vercel-gateway で切り替える。

# TypeSafe 直結 (https://docs.typesafe.ai)
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Vercel AI Gateway 経由 (https://vercel.com/ai-gateway/models/jev)
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
