# .env.local にコピーして値を入れる。どれか 1 つがあれば動く。
# 複数ある場合は TypeSafe 直結 → Vercel AI Gateway → OpenRouter の順で先に見つかった方を使う。
# --provider vercel-gateway / --provider openrouter で切り替える。
# Cloudflare は --provider cloudflare を付けたときだけ使う。

# TypeSafe 直結 (https://docs.typesafe.ai)
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Vercel AI Gateway 経由 (https://vercel.com/ai-gateway/models/jev)
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai

# OpenRouter 経由 (https://openrouter.ai/typesafe/jev-1.13)
OPENROUTER_API_KEY=
# 末尾は /v1。Jev への問い合わせは /v1 を /alpha に置き換えた URL に送る
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cloudflare 経由 (https://developers.cloudflare.com/ai/models/typesafe/jev/)
# トークンには Account > Workers AI > Read の権限を付ける。wrangler と同じ変数名
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
