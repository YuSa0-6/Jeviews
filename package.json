{
  "name": "jeview",
  "version": "0.0.1",
  "description": "Jev だけで回るコードレビュー CLI の最小構成",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuSa0-6/Jeviews.git"
  },
  "bin": {
    "jeview": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval:sample": "node evals/scripts/sample.mjs",
    "eval:teacher": "node evals/scripts/teacher.mjs",
    "eval:scan": "node evals/scripts/scan.mjs",
    "eval:score": "node evals/scripts/score.mjs",
    "eval:diff": "node evals/scripts/diff.mjs",
    "eval:codex": "node evals/scripts/codex.mjs"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
